<div class="brand-strip page-width">
  <div class="brand-strip__header">
    <h2>{{ section.settings.heading }}</h2>
    <a href="{{ section.settings.view_all_link }}" class="view-all">View All &rsaquo;</a>
  </div>
  <div class="brand-strip__row">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link }}" class="brand-strip__item" {{ block.shopify_attributes }}>
        {%- if block.settings.logo != blank -%}
          <img
            src="{{ block.settings.logo | image_url: width: 160 }}"
            width="{{ block.settings.logo.width }}"
            height="{{ block.settings.logo.height }}"
            alt="{{ block.settings.name | escape }}"
            loading="lazy">
        {%- else -%}
          <span>{{ block.settings.name }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop by brand",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Brand" },
    { "type": "url", "id": "view_all_link", "label": "View all link" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Brand name", "default": "Brand" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by brand",
      "blocks": [
        { "type": "brand", "settings": { "name": "Brand 1" } },
        { "type": "brand", "settings": { "name": "Brand 2" } },
        { "type": "brand", "settings": { "name": "Brand 3" } },
        { "type": "brand", "settings": { "name": "Brand 4" } }
      ]
    }
  ]
}
{% endschema %}
