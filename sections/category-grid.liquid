<div class="category-grid-wrap page-width">
  <div class="category-grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link }}" class="category-grid__item" {{ block.shopify_attributes }}>
        <div class="category-grid__image">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 200 }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              alt="{{ block.settings.title | escape }}"
              loading="lazy">
          {%- endif -%}
        </div>
        <span>{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Category grid",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "category", "settings": { "title": "Fresh Vegetables" } },
        { "type": "category", "settings": { "title": "Fruits" } },
        { "type": "category", "settings": { "title": "Rice & Grains" } },
        { "type": "category", "settings": { "title": "Atta & Flour" } },
        { "type": "category", "settings": { "title": "Dal & Pulses" } },
        { "type": "category", "settings": { "title": "Spices" } },
        { "type": "category", "settings": { "title": "Snacks" } },
        { "type": "category", "settings": { "title": "Tea & Coffee" } }
      ]
    }
  ]
}
{% endschema %}
