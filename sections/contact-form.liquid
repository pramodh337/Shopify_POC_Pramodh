<div class="contact-form page-width customer-page--narrow">
  <h2>{{ section.settings.heading }}</h2>
  {%- form 'contact' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-success">Thanks! We'll get back to you soon.</p>
    {%- endif -%}
    <label for="ContactName">Name</label>
    <input type="text" name="contact[name]" id="ContactName">

    <label for="ContactEmail">Email</label>
    <input type="email" name="contact[email]" id="ContactEmail" value="{{ form.email }}" required>

    <label for="ContactPhone">Phone</label>
    <input type="tel" name="contact[phone]" id="ContactPhone">

    <label for="ContactMessage">Message</label>
    <textarea name="contact[body]" id="ContactMessage" rows="5" required></textarea>

    <button type="submit" class="btn btn--primary">Send Message</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in Touch" }
  ]
}
{% endschema %}
