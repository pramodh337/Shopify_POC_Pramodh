<div class="features-bar page-width">
  {%- for block in section.blocks -%}
    <div class="features-bar__item" {{ block.shopify_attributes }}>
      <div class="features-bar__icon" style="background:{{ block.settings.icon_bg }};">
        {%- case block.settings.icon -%}
          {%- when 'leaf' -%}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M11 20A7 7 0 0 1 4 13c0-5 4-11 7-11s7 6 7 11a7 7 0 0 1-7 7z"/></svg>
          {%- when 'truck' -%}
            {% render 'icon-truck' %}
          {%- when 'lock' -%}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          {%- when 'shield' -%}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/></svg>
        {%- endcase -%}
      </div>
      <div>
        <strong>{{ block.settings.title }}</strong>
        <span>{{ block.settings.subtitle }}</span>
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Trust features bar",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
          { "value": "leaf", "label": "Leaf" },
          { "value": "truck", "label": "Truck" },
          { "value": "lock", "label": "Lock" },
          { "value": "shield", "label": "Shield" }
        ]},
        { "type": "color", "id": "icon_bg", "label": "Icon background", "default": "#1E7A34" },
        { "type": "text", "id": "title", "label": "Title", "default": "Fresh Products" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Sourced daily from trusted suppliers" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust features bar",
      "blocks": [
        { "type": "feature", "settings": { "icon": "leaf", "icon_bg": "#1E7A34", "title": "Fresh Products", "subtitle": "Sourced daily from trusted suppliers" } },
        { "type": "feature", "settings": { "icon": "truck", "icon_bg": "#E12026", "title": "Fast Delivery", "subtitle": "Quick & reliable delivery to your door" } },
        { "type": "feature", "settings": { "icon": "lock", "icon_bg": "#F5C518", "title": "Secure Payments", "subtitle": "100% secure payment options" } },
        { "type": "feature", "settings": { "icon": "shield", "icon_bg": "#0EA5A0", "title": "Trusted Quality", "subtitle": "Premium quality you can trust" } }
      ]
    }
  ]
}
{% endschema %}
