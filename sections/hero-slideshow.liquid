<div class="hero-slideshow" id="HeroSlideshow-{{ section.id }}">
  <div class="hero-slideshow__track">
    {%- for block in section.blocks -%}
      {%- if block.type == 'image_slide' -%}
        <div class="hero-slide hero-slide--image-only {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link }}" class="hero-slide__full-link">
            {%- if block.settings.image != blank -%}
              <picture>
                {%- if block.settings.mobile_image != blank -%}
                  <source media="(max-width: 640px)" srcset="{{ block.settings.mobile_image | image_url: width: 800 }}">
                {%- endif -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1600 }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  alt="{{ block.settings.image.alt | default: 'Promotional slide' | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  class="hero-slide__full-image">
              </picture>
            {%- endif -%}
          </a>
        </div>
      {%- else -%}
        <div class="hero-slide {% if forloop.first %}is-active{% endif %}" style="background-color:{{ block.settings.bg_color }};" {{ block.shopify_attributes }}>
          <div class="hero-slide__content">
            {%- if block.settings.badge_text != blank -%}
              <div class="hero-slide__badge">
                <span>{{ block.settings.badge_text }}</span>
              </div>
            {%- endif -%}
            <h2>{{ block.settings.heading }}</h2>
            <p>{{ block.settings.subheading }}</p>
            <div class="hero-slide__buttons">
              {%- if block.settings.button_1_text != blank -%}
                <a href="{{ block.settings.button_1_link }}" class="btn btn--primary">{{ block.settings.button_1_text }}</a>
              {%- endif -%}
              {%- if block.settings.button_2_text != blank -%}
                <a href="{{ block.settings.button_2_link }}" class="btn btn--outline">{{ block.settings.button_2_text }}</a>
              {%- endif -%}
            </div>
          </div>
          {%- if block.settings.image != blank -%}
            <div class="hero-slide__image">
              <picture>
                {%- if block.settings.mobile_image != blank -%}
                  <source media="(max-width: 640px)" srcset="{{ block.settings.mobile_image | image_url: width: 500 }}">
                {%- endif -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  alt="{{ block.settings.heading | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
              </picture>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
  <button class="hero-slideshow__arrow hero-slideshow__arrow--prev" data-slide-prev aria-label="Previous slide">{% render 'icon-chevron-left' %}</button>
  <button class="hero-slideshow__arrow hero-slideshow__arrow--next" data-slide-next aria-label="Next slide">{% render 'icon-chevron-right' %}</button>
  <div class="hero-slideshow__dots">
    {%- for block in section.blocks -%}
      <button class="dot {% if forloop.first %}is-active{% endif %}" data-slide-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
    {%- endfor -%}
  </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero slideshow",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide (text + buttons)",
      "settings": [
        { "type": "text", "id": "badge_text", "label": "Badge text", "default": "UP TO 20% OFF" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Freshness You Can Trust" },
        { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Wide range of fresh vegetables delivered to your door" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)", "info": "Shown on phones instead of the image above" },
        { "type": "color", "id": "bg_color", "label": "Background color", "default": "#DFF0D8" },
        { "type": "text", "id": "button_1_text", "label": "Button 1 text", "default": "Shop Now" },
        { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
        { "type": "text", "id": "button_2_text", "label": "Button 2 text", "default": "View Offers" },
        { "type": "url", "id": "button_2_link", "label": "Button 2 link" }
      ]
    },
    {
      "type": "image_slide",
      "name": "Image slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)", "info": "Shown on phones instead of the image above" },
        { "type": "url", "id": "link", "label": "Link", "info": "Where clicking the image should go, e.g. a collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
