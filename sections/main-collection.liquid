<div class="collection-page page-width">
  <div class="collection-page__header">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-page__description">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- paginate collection.products by 24 -%}
  <form id="FacetFilterForm" method="get"></form>

  <div class="collection-page__toolbar">
    <span>{{ collection.products_count }} products</span>
    <label for="SortBy">
      {{ 'collections.general.sort_by' | t }}
      <select name="sort_by" id="SortBy" form="FacetFilterForm" onchange="this.form.submit()">
        {%- assign sort_options = 'manual,best-selling,title-ascending,title-descending,price-ascending,price-descending,created-descending' | split: ',' -%}
        {%- for option in sort_options -%}
          <option value="{{ option }}" {% if collection.sort_by == option or collection.default_sort_by == option and collection.sort_by == blank %}selected{% endif %}>
            {{ option | replace: '-', ' ' | capitalize }}
          </option>
        {%- endfor -%}
      </select>
    </label>
  </div>

  <div class="collection-page__layout">
      <aside class="collection-page__filters">
        {%- assign has_active_filters = false -%}
        {%- for filter in collection.filters -%}
          {%- for value in filter.values -%}
            {%- if value.active -%}{%- assign has_active_filters = true -%}{%- endif -%}
          {%- endfor -%}
        {%- endfor -%}

        {%- if has_active_filters -%}
          <div class="facet-active">
            <h4>Filtered by</h4>
            <div class="facet-active__chips">
              {%- for filter in collection.filters -%}
                {%- for value in filter.values -%}
                  {%- if value.active -%}
                    <a href="{{ value.url_to_remove }}" class="facet-active__chip">{{ value.label }} <span aria-hidden="true">&times;</span></a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </div>
            <a href="{{ collection.url }}{% if collection.sort_by %}?sort_by={{ collection.sort_by }}{% endif %}" class="facet-active__clear">Clear filters</a>
          </div>
        {%- endif -%}

        <div class="facet">
          <h4 class="facet__title">Category</h4>
          <div class="facet__body">
            <ul class="facet__list facet__list--links">
              {%- assign categories = 'Fresh Vegetables:fresh-vegetables,Fruits:fruits,Rice & Grains:rice-grains,Atta & Flour:atta-flour,Dal & Pulses:dal-pulses,Spices:spices,Snacks:snacks,Tea & Coffee:tea-coffee,Frozen Foods:frozen-foods' | split: ',' -%}
              {%- for category in categories -%}
                {%- assign category_parts = category | split: ':' -%}
                {%- assign category_title = category_parts.first -%}
                {%- assign category_handle = category_parts.last -%}
                <li>
                  <a href="{{ collections[category_handle].url | default: routes.all_products_collection_url }}" class="facet__link{% if collection.handle == category_handle %} is-active{% endif %}">
                    <span class="facet__dot"></span>{{ category_title | escape }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>

        {%- for filter in collection.filters -%}
          {%- unless filter.type == 'price_range' -%}
            <div class="facet">
              <h4 class="facet__title">{{ filter.label }}</h4>
              <div class="facet__body">
                {%- assign filter_has_active = false -%}
                {%- for value in filter.values -%}
                  {%- if value.active -%}{%- assign filter_has_active = true -%}{%- endif -%}
                {%- endfor -%}
                <ul class="facet__list" data-facet-list>
                  <li class="facet__all">
                    <label>
                      <input type="radio" data-facet-all form="FacetFilterForm" {% unless filter_has_active %}checked{% endunless %}>
                      All
                    </label>
                  </li>
                  {%- for value in filter.values -%}
                    <li{% if forloop.index > 6 %} class="facet__extra" hidden{% endif %}>
                      <label>
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          form="FacetFilterForm"
                          onchange="this.form.submit()"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                        {{ value.label }} ({{ value.count }})
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
                {%- if filter.values.size > 6 -%}
                  <button type="button" class="facet__see-more" data-facet-toggle>See more</button>
                {%- endif -%}
              </div>
            </div>
          {%- endunless -%}
        {%- endfor -%}
        {%- if collection.filters.size > 0 -%}
          <button type="submit" form="FacetFilterForm" class="btn btn--primary btn--small btn--full">Apply filters</button>
        {%- endif -%}
      </aside>

    <div class="collection-page__grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>{{ 'collections.general.no_products' | t }}</p>
      {%- endfor -%}
    </div>
  </div>

  {%- if paginate.pages > 1 -%}
  <div class="pagination">
    {{ paginate | default_pagination }}
  </div>
  {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Collection page", "settings": [] }
{% endschema %}
