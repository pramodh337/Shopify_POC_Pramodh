<div class="collection-page page-width">
  <div class="collection-page__header">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-page__description">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  <div class="collection-page__toolbar">
    <span>{{ collection.products_count }} products</span>
    <form id="SortForm">
      <label for="SortBy">{{ 'collections.general.sort_by' | t }}</label>
      <select name="sort_by" id="SortBy" onchange="window.location.href=this.value">
        {%- assign sort_options = 'manual,best-selling,title-ascending,title-descending,price-ascending,price-descending,created-descending' | split: ',' -%}
        {%- for option in sort_options -%}
          <option value="{{ collection.url }}?sort_by={{ option }}" {% if collection.sort_by == option or collection.default_sort_by == option and collection.sort_by == blank %}selected{% endif %}>
            {{ option | replace: '-', ' ' | capitalize }}
          </option>
        {%- endfor -%}
      </select>
    </form>
  </div>

  <div class="collection-page__grid">
    {%- paginate collection.products by 24 -%}
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>{{ 'collections.general.no_products' | t }}</p>
      {%- endfor -%}

      {%- if paginate.pages > 1 -%}
      <div class="pagination">
        {{ paginate | default_pagination }}
      </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{ "name": "Collection page", "settings": [] }
{% endschema %}
