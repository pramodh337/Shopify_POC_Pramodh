<div class="search-page page-width">
  <h1>
    {%- if search.performed -%}
      {{ 'general.search.results_for' | t }} "{{ search.terms }}"
    {%- else -%}
      Search
    {%- endif -%}
  </h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
    <button type="submit">{% render 'icon-search' %}</button>
  </form>

  {%- if search.performed -%}
    <div class="collection-page__grid">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {% render 'product-card', product: item %}
        {%- endif -%}
      {%- else -%}
        <p>{{ 'general.search.no_results' | t }} "{{ search.terms }}"</p>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Search page", "settings": [] }
{% endschema %}
